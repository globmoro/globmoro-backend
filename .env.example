# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Comma-separated frontend origins allowed by CORS
# Example: https://globmoro.com,https://www.globmoro.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Light rate limit for POST /api/inquiries (per IP)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
