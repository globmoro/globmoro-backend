# --- Required for EasyPanel / production ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Comma-separated frontend origins (no trailing slashes)
# Production example:
# CORS_ORIGINS=https://globmoro.com,https://www.globmoro.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional (defaults shown) ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# --- Inquiry email (Gmail SMTP / App Password) ---
# Destination for new inquiries (default Globmoro@gmail.com)
INQUIRY_TO_EMAIL=Globmoro@gmail.com

# Required to send mail. In non-production, missing SMTP skips send with a warn log.
# In production, missing SMTP logs inquiry_email_misconfigured loudly (inquiry still stored).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Globmoro@gmail.com
SMTP_PASS=
# Optional From header (defaults to SMTP_USER)
# SMTP_FROM=Globmoro <Globmoro@gmail.com>
