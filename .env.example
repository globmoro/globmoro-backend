# --- Required for EasyPanel / production ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Comma-separated frontend origins (no trailing slashes)
# Production example:
# CORS_ORIGINS=https://globmoro.com,https://www.globmoro.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional (defaults shown) ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
